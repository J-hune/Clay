#version 430
layout(local_size_x = 256) in;

layout(binding = 0, r32i) uniform iimage2D heightmap; // height en fixed-point int
layout(binding = 2, std430) readonly buffer ModificationBuffer {
    float modifications[];
};

uniform int numParticles;
uniform int maxLifetime;
uniform int mapSize;            // pour clamp
uniform int fixedPointScale;    // ex: 10000

const int STEP_SIZE = 6;

void main() {
    uint modIndex = gl_GlobalInvocationID.x;
    uint totalMods = uint(numParticles) * uint(maxLifetime);
    if (modIndex >= totalMods) return;

    int base = int(modIndex) * STEP_SIZE;
    float fx = modifications[base + 4];
    float fy = modifications[base + 5];

    int ix = int(modifications[base + 0]);
    int iy = int(modifications[base + 1]);
    float amount = modifications[base + 2];
    int radius = int(modifications[base + 3]);

    // si step non utilisé -> amount == 0.0 (ou very small)
    if (abs(amount) < 1e-8) return;

    // Dépôt (bilinear) : distribuer sur 4 texels
    if (amount > 0.0) {
        // poids bilinéaire
        float wx0 = 1.0 - fx;
        float wy0 = 1.0 - fy;
        float w00 = wx0 * wy0;
        float w10 = fx  * wy0;
        float w01 = wx0 * fy;
        float w11 = fx  * fy;

        // convert to fixed-int deltas
        int delta00 = int(round(amount * float(fixedPointScale) * w00));
        int delta10 = int(round(amount * float(fixedPointScale) * w10));
        int delta01 = int(round(amount * float(fixedPointScale) * w01));
        int delta11 = int(round(amount * float(fixedPointScale) * w11));

        // bounds check and atomic adds
        ivec2 p00 = ivec2(ix, iy);
        if (p00.x >= 0 && p00.x < mapSize && p00.y >= 0 && p00.y < mapSize)
        imageAtomicAdd(heightmap, p00, delta00);

        ivec2 p10 = ivec2(ix + 1, iy);
        if (p10.x >= 0 && p10.x < mapSize && p10.y >= 0 && p10.y < mapSize)
        imageAtomicAdd(heightmap, p10, delta10);

        ivec2 p01 = ivec2(ix, iy + 1);
        if (p01.x >= 0 && p01.x < mapSize && p01.y >= 0 && p01.y < mapSize)
        imageAtomicAdd(heightmap, p01, delta01);

        ivec2 p11 = ivec2(ix + 1, iy + 1);
        if (p11.x >= 0 && p11.x < mapSize && p11.y >= 0 && p11.y < mapSize)
        imageAtomicAdd(heightmap, p11, delta11);

    } else {
        // Érosion : distribuer sur un disque de 'radius' avec pondération linéaire
        // amount négatif => delta négatif
        float amt = -amount; // positif magnitude
        int r = max(1, radius);

        int minX = max(0, ix - r);
        int maxX = min(mapSize - 1, ix + r);
        int minY = max(0, iy - r);
        int maxY = min(mapSize - 1, iy + r);

        // itérer les pixels dans le carré contenant le disque
        for (int y = minY; y <= maxY; ++y) {
            for (int x = minX; x <= maxX; ++x) {
                float dx = float(x - ix);
                float dy = float(y - iy);
                float dist = sqrt(dx*dx + dy*dy);
                if (dist > float(r)) continue;

                float weight = max(0.0, float(r) - dist) / float(r); // linéaire
                float deltaF = -amt * weight; // négatif
                int deltaI = int(round(deltaF * float(fixedPointScale)));
                // deltaI est négatif, imageAtomicAdd accepte int

                // Interdire dépassement en dessous de 0 dans l'image heightmap
                if (imageLoad(heightmap, ivec2(x, y)).r + deltaI < 0) {
                    // ajuster deltaI pour ne pas descendre en dessous de 0
                    deltaI = -imageLoad(heightmap, ivec2(x, y)).r;
                }

                imageAtomicAdd(heightmap, ivec2(x, y), deltaI);
            }
        }
    }
}
